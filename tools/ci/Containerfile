# CI: a Debian machine with systemd as PID 1, to test deploy/install.sh and the services
# (.github/workflows/deploy.yml). Run by podman, which prepares it for systemd itself:
# no --privileged needed (only CAP_SYS_ADMIN, for the hardening of the units).
FROM debian:trixie
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       systemd systemd-sysv python3 python3-venv openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
